# ─────────────────────────────────────────────
# 綠界 ECPay 金流設定範例
# 用法：複製這個檔案成 .env（本機測試），或把這些變數填到 Vercel 後台。
# ⚠️ 真正的密鑰「不要」提交到 git！.env 已被 .gitignore 忽略。
# ─────────────────────────────────────────────

# 環境：test（測試）或 production（正式）。先用 test。
ECPAY_ENV=test

# 綠界商店資訊（測試環境可先留空，程式會用綠界官方公開測試帳號）
# 正式上線時，換成你在綠界後台拿到的值：
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=

# 你的網站對外網址（部署到 Vercel 後填，例如 https://mandy-exam.vercel.app）
# 綠界的付款結果通知需要打到這個網址。
PUBLIC_BASE_URL=
FRONTEND_URL=

# ─────────────────────────────────────────────
# 前端用（Vite）：只有在「前端和後端分開部署」時才需要。
# 若整個專案都放 Vercel，這個留空即可。
# 例：VITE_PAYMENT_API=https://mandy-pay.vercel.app
# ─────────────────────────────────────────────
VITE_PAYMENT_API=
